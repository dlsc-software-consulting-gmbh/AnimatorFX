<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dlsc.animatorfx</groupId>
        <artifactId>animatorfx-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>animatorfx-editor</artifactId>
    <name>AnimatorFX Editor</name>

    <properties>
        <maven.compiler.release>${editor.java.release}</maven.compiler.release>
        <!-- mvn javafx:run -Danimatorfx.configDir=<dir> -Danimatorfx.args="<file.afx> ..." -->
        <animatorfx.configDir/>
        <animatorfx.args/>
        <!-- Platform specific jpackage options of the "package" profile; empty = jpackage defaults (default icon). -->
        <package.platform.options/>
        <!-- animatorfx.audio=off: no test makes sound; tests that look at sound install a recording output. -->
        <!-- TestFX brings OSGi onto the test class path; Ikonli then tries its OSGi resolver and needs to read it. -->
        <!-- JavaFX's bundled Headless backend supports the JavaFX 27 window APIs; Monocle 21 does not. -->
        <surefire.jvm.args>-Dglass.platform=Headless -Dtestfx.robot=glass -Dprism.order=sw -Djava.awt.headless=true --enable-native-access=javafx.graphics,javafx.media,com.sun.jna --add-exports javafx.graphics/com.sun.glass.ui=ALL-UNNAMED --add-exports javafx.graphics/com.sun.javafx.application=ALL-UNNAMED --add-opens javafx.graphics/com.sun.javafx.application=ALL-UNNAMED --add-reads org.kordamp.ikonli.core=ALL-UNNAMED -Danimatorfx.audio=off</surefire.jvm.args>
    </properties>

    <!-- Pins every (also transitive) JavaFX artifact to the editor JavaFX version. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-base</artifactId>
                <version>${javafx.editor.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-graphics</artifactId>
                <version>${javafx.editor.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.editor.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-fxml</artifactId>
                <version>${javafx.editor.version}</version>
            </dependency>
            <!-- required by the AnimatorFX player (sound) -->
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-media</artifactId>
                <version>${javafx.editor.version}</version>
            </dependency>
            <!-- required by GemsFX -->
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-swing</artifactId>
                <version>${javafx.editor.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.dlsc.animatorfx</groupId>
            <artifactId>animatorfx-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dlsc.animatorfx</groupId>
            <artifactId>animatorfx-player</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dlsc.animatorfx</groupId>
            <artifactId>animatorfx-import</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <!-- audio info and approximate waveforms of compressed sounds -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-material2-pack</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dlsc.gemsfx</groupId>
            <artifactId>gemsfx</artifactId>
            <exclusions>
                <!-- a Maven dependency of PickerFX that no module descriptor requires -->
                <exclusion>
                    <groupId>org.controlsfx</groupId>
                    <artifactId>controlsfx</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.microsoft</groupId>
            <artifactId>credential-secure-storage</artifactId>
            <version>1.0.3</version>
            <exclusions>
                <exclusion>
                    <groupId>net.java.dev.jna</groupId>
                    <artifactId>jna-platform</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>1.24.0</version>
            <exclusions>
                <exclusion>
                    <groupId>dev.langchain4j</groupId>
                    <artifactId>langchain4j-http-client-jdk</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-anthropic</artifactId>
            <version>1.24.0</version>
            <exclusions>
                <exclusion>
                    <groupId>dev.langchain4j</groupId>
                    <artifactId>langchain4j-http-client-jdk</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform-jpms</artifactId>
            <version>5.15.0</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.17</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/build.properties</exclude>
                </excludes>
            </resource>
            <!-- the version shown in the About dialog -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/build.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.dlsc.animatorfx.editor/com.dlsc.animatorfx.editor.AnimatorApp</mainClass>
                    <options>
                        <!-- empty = the per-user configuration directory -->
                        <option>-Danimatorfx.configDir=${animatorfx.configDir}</option>
                        <option>--enable-native-access=javafx.graphics,javafx.media,com.sun.jna</option>
                    </options>
                    <commandlineArgs>${animatorfx.args}</commandlineArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      Native packaging: mvn -Ppackage -pl animatorfx-editor -am package
      (add -DskipTests when the tests have already run). Needs the jlink and jpackage tools of the JDK that runs Maven.

      1. Copy runtime dependencies and the editor jar to target/package/app/lib.
      2. Move the platform JavaFX modules to target/package/javafx and create a class-path launcher.
      3. jlink: link JavaFX and JDK modules -> target/package/runtime. LangChain4j uses automatic
         modules, which jlink cannot link, so application libraries run on the class path.
      4. jpackage: wrap the application and runtime into an image for the current platform -> target/dist
         (AnimatorFX.app on macOS, a directory AnimatorFX elsewhere). No installer, no signing.
    -->
    <profiles>
        <profile>
            <id>jdeploy</id>
            <build>
                <finalName>AnimatorFX</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>${maven-dependency-plugin.version}</version>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <!-- jDeploy supplies platform-specific JavaFX, including media. -->
                            <excludeGroupIds>org.openjfx</excludeGroupIds>
                        </configuration>
                        <executions>
                            <execution>
                                <id>jdeploy-dependencies</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/jdeploy/lib</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>${maven-antrun-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>jdeploy-prepare</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete dir="${project.build.directory}/jdeploy"/>
                                        <mkdir dir="${project.build.directory}/jdeploy"/>
                                        <copy file="${maven.multiModuleProjectDirectory}/icon.png"
                                              tofile="${project.build.directory}/jdeploy/icon.png"/>
                                        <copy file="${maven.multiModuleProjectDirectory}/LICENSE"
                                              todir="${project.build.directory}/jdeploy"/>
                                        <copy file="${maven.multiModuleProjectDirectory}/NOTICE"
                                              todir="${project.build.directory}/jdeploy"/>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jdeploy-manifest</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <manifestclasspath property="jdeploy.classpath"
                                                           jarfile="${project.build.directory}/jdeploy/AnimatorFX-jdeploy.jar">
                                            <classpath>
                                                <fileset dir="${project.build.directory}/jdeploy/lib" includes="*.jar"/>
                                            </classpath>
                                        </manifestclasspath>
                                        <manifest file="${project.build.directory}/jdeploy/MANIFEST.MF">
                                            <attribute name="Class-Path" value="${jdeploy.classpath}"/>
                                            <attribute name="Enable-Native-Access" value="ALL-UNNAMED"/>
                                        </manifest>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.5.1</version>
                        <executions>
                            <execution>
                                <id>jdeploy-launcher</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>jdeploy</classifier>
                                    <outputDirectory>${project.build.directory}/jdeploy</outputDirectory>
                                    <archive>
                                        <manifest>
                                            <mainClass>com.dlsc.animatorfx.editor.Launcher</mainClass>
                                        </manifest>
                                        <manifestFile>${project.build.directory}/jdeploy/MANIFEST.MF</manifestFile>
                                    </archive>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>license-maven-plugin</artifactId>
                        <version>2.9.0</version>
                        <executions>
                            <execution>
                                <id>jdeploy-dependency-licenses</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>download-licenses</goal>
                                </goals>
                                <configuration>
                                    <includedScopes>compile,runtime</includedScopes>
                                    <excludedGroups>com\.dlsc\.animatorfx</excludedGroups>
                                    <licensesOutputDirectory>${project.build.directory}/jdeploy/licenses</licensesOutputDirectory>
                                    <licensesOutputFile>${project.build.directory}/jdeploy/licenses/dependencies.xml</licensesOutputFile>
                                    <errorRemedy>xmlOutput</errorRemedy>
                                    <licenseUrlReplacements>
                                        <licenseUrlReplacement>
                                            <regexp>https://github.com/weisj/jsvg/blob/master/LICENSE</regexp>
                                            <replacement>https://raw.githubusercontent.com/weisj/jsvg/master/LICENSE</replacement>
                                        </licenseUrlReplacement>
                                    </licenseUrlReplacements>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>package-macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <package.platform.options>--icon "${project.basedir}/src/package/macos/AnimatorFX.icns" --mac-package-identifier com.dlsc.animatorfx.editor</package.platform.options>
            </properties>
        </profile>
        <profile>
            <id>package</id>
            <properties>
                <!-- jpackage accepts neither -SNAPSHOT nor, on macOS, a leading 0 -->
                <package.version>1.0.0</package.version>
                <package.work>${project.build.directory}/package</package.work>
                <package.dist>${project.build.directory}/dist</package.dist>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>${maven-dependency-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>package-modules</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${package.work}/app/lib</outputDirectory>
                                    <overWriteReleases>true</overWriteReleases>
                                    <overWriteSnapshots>true</overWriteSnapshots>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>${maven-antrun-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>package-clean</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete dir="${package.work}/app"/>
                                        <delete dir="${package.work}/javafx"/>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>package-prepare</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                              todir="${package.work}/app/lib"/>
                                        <delete>
                                            <fileset dir="${package.work}/app/lib"
                                                     includes="javafx-*-${javafx.editor.version}.jar"/>
                                        </delete>
                                        <mkdir dir="${package.work}/javafx"/>
                                        <move todir="${package.work}/javafx">
                                            <fileset dir="${package.work}/app/lib" includes="javafx-*.jar"/>
                                        </move>
                                        <manifestclasspath property="package.classpath"
                                                           jarfile="${package.work}/app/AnimatorFX-launcher.jar">
                                            <classpath>
                                                <fileset dir="${package.work}/app/lib" includes="*.jar"/>
                                            </classpath>
                                        </manifestclasspath>
                                        <jar destfile="${package.work}/app/AnimatorFX-launcher.jar" whenempty="create">
                                            <manifest>
                                                <attribute name="Main-Class" value="com.dlsc.animatorfx.editor.Launcher"/>
                                                <attribute name="Class-Path" value="${package.classpath}"/>
                                            </manifest>
                                        </jar>
                                        <!-- jlink and jpackage refuse to write into an existing directory -->
                                        <delete dir="${package.work}/runtime"/>
                                        <delete dir="${package.dist}"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>package-jlink</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jlink</executable>
                                    <arguments>
                                        <argument>--module-path</argument>
                                        <argument>${package.work}/javafx</argument>
                                        <argument>--add-modules</argument>
                                        <argument>java.se,jdk.crypto.ec,jdk.unsupported,javafx.controls,javafx.fxml,javafx.media,javafx.swing</argument>
                                        <argument>--exclude-resources=glob:**/OSGI-INF/**</argument>
                                        <argument>--strip-debug</argument>
                                        <argument>--no-header-files</argument>
                                        <argument>--no-man-pages</argument>
                                        <argument>--output</argument>
                                        <argument>${package.work}/runtime</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>package-jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <commandlineArgs>--type app-image --name AnimatorFX --app-version ${package.version} --vendor DLSC --runtime-image "${package.work}/runtime" --input "${package.work}/app" --main-jar AnimatorFX-launcher.jar --main-class com.dlsc.animatorfx.editor.Launcher --java-options --add-modules=javafx.controls,javafx.fxml,javafx.media,javafx.swing --java-options --enable-native-access=javafx.graphics,javafx.media,ALL-UNNAMED --dest "${package.dist}" ${package.platform.options}</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>license-maven-plugin</artifactId>
                        <version>2.9.0</version>
                        <executions>
                            <execution>
                                <id>package-dependency-licenses</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>download-licenses</goal>
                                </goals>
                                <configuration>
                                    <includedScopes>compile,runtime</includedScopes>
                                    <excludedGroups>com\.dlsc\.animatorfx</excludedGroups>
                                    <licensesOutputDirectory>${package.dist}/licenses</licensesOutputDirectory>
                                    <licensesOutputFile>${package.dist}/licenses/dependencies.xml</licensesOutputFile>
                                    <errorRemedy>xmlOutput</errorRemedy>
                                    <licenseUrlReplacements>
                                        <licenseUrlReplacement>
                                            <regexp>https://github.com/weisj/jsvg/blob/master/LICENSE</regexp>
                                            <replacement>https://raw.githubusercontent.com/weisj/jsvg/master/LICENSE</replacement>
                                        </licenseUrlReplacement>
                                    </licenseUrlReplacements>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
